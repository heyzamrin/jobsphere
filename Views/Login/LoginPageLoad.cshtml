
@model MVCProjectOne.Models.LoginClass

@{
    ViewBag.Title = "Login";
}

<style>

    body {
        background-color: #f5f7fb;
        font-family: Arial, Helvetica, sans-serif;
    }

    .login-container {
        width: 400px;
        margin: 50px auto;
    }

    .login-card {
        background-color: #ffffff;
        padding: 35px 35px;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        border: 1px solid #edf0f4;
    }

    /* ================= TITLE ================= */

    .login-title {
        text-align: center;
        margin: 0 0 25px;
        color: #063970;
        font-size: 28px;
        font-weight: bold;
    }

    /* ================= FORM ================= */

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            margin-bottom: 7px;
            font-weight: bold;
            color: #444444;
            font-size: 14px;
        }

    /* ================= INPUT ================= */

    .form-control {
        width: 100%;
        height: 44px;
        padding: 10px 12px;
        border: 1px solid #d5d9e0;
        border-radius: 6px;
        box-sizing: border-box;
        font-size: 14px;
        outline: none;
        display: block;
    }

        .form-control:focus {
            border-color: #063970;
            box-shadow: 0 0 0 2px rgba(6,57,112,0.08);
        }

    /* ================= VALIDATION ================= */

    .validation {
        color: #d9534f;
        font-size: 13px;
        display: block;
        margin-top: 5px;
    }

    /* ================= BUTTON ================= */

    .button-section {
        text-align: center;
        margin-top: 25px;
    }

    .login-btn {
        width: 100%;
        height: 44px;
        padding: 10px;
        background-color: #063970;
        color: #ffffff;
        border: none;
        border-radius: 6px;
        font-size: 15px;
        font-weight: bold;
        cursor: pointer;
        box-sizing: border-box;
        display: block;
    }

        .login-btn:hover {
            background-color: #042b55;
        }

    /* ================= REGISTRATION LINKS ================= */

    .register-links {
        text-align: center;
        margin-top: 20px;
        font-size: 13px;
    }

        .register-links p {
            margin: 0 0 9px;
            color: #777777;
        }

        .register-links a {
            color: #063970;
            font-weight: bold;
            text-decoration: none;
        }

            .register-links a:hover {
                color: #042b55;
                text-decoration: underline;
            }

        .register-links span {
            margin: 0 8px;
            color: #bbbbbb;
        }

    /* ================= ERROR MESSAGE ================= */

    .error-message {
        margin-top: 15px;
        padding: 10px;
        color: #b02a37;
        background-color: #f8d7da;
        border: 1px solid #f1b0b7;
        border-radius: 6px;
        font-size: 13px;
        text-align: center;
    }
</style>

<div class="login-container">

    <div class="login-card">

        <h2 class="login-title">Login</h2>

        @using (Html.BeginForm("LoginClick", "Login", FormMethod.Post))
        {
            <div class="form-group">

                <label>Email</label>

                @Html.TextBoxFor(m => m.lEmail, new
                {
                    @class = "form-control",
                    placeholder = "Enter email address"
                })

                @Html.ValidationMessageFor(m => m.lEmail, "", new
                {
                    @class = "validation"
                })

            </div>

            <div class="form-group">

                <label>Password</label>

                @Html.PasswordFor(m => m.lPassword, new
                {
                    @class = "form-control",
                    placeholder = "Enter password"
                })

                @Html.ValidationMessageFor(m => m.lPassword, "", new
                {
                    @class = "validation"
                })

            </div>

            <div class="button-section">

                <input type="submit"
                       value="Login"
                       class="login-btn" />

                <div class="register-links">

                    <p>Don't have an account?</p>

                    @Html.ActionLink(
                        "Register as Employee",
                        "InsertEmployeePageLoad",
                        "EmployeeReg"
                    )

                    <span>|</span>

                    @Html.ActionLink(
                        "Register as Company",
                        "InsertCompanyPageLoad",
                        "CompanyReg"
                    )

                </div>

                @if (Model != null && !string.IsNullOrEmpty(Model.lMsg))
                {
                    <div class="error-message">
                        @Model.lMsg
                    </div>
                }

            </div>
        }

    </div>

</div>






